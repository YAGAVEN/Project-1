                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?type=INCOME",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"],
              "query": [{ "key": "type", "value": "INCOME" }]
            }
          }
        },
        {
          "name": "Create goal Car (target 100000)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "if (body.id) pm.collectionVariables.set('goalId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/goals", "host": ["{{baseUrl}}"], "path": ["api", "v1", "goals"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Car\",\n  \"targetAmount\": 100000.00\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Contribution 5000 LAST MONTH (the cumulative base)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/goals/{{goalId}}/contributions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "goals", "{{goalId}}", "contributions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000.00,\n  \"contributionDate\": \"{{lastMonth}}\",\n  \"notes\": \"Old stash\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Contribution 3000 today",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/goals/{{goalId}}/contributions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "goals", "{{goalId}}", "contributions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 3000.00,\n  \"contributionDate\": \"{{today}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "INCOME 50000 → bank (today)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"INCOME\",\n  \"amount\": 50000.00,\n  \"toAccountId\": \"{{bankAccountId}}\",\n  \"categoryId\": \"{{incomeCategoryId}}\",\n  \"description\": \"Monthly salary\",\n  \"transactionDate\": \"{{today}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "EXPENSE 2000 from bank (today)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"EXPENSE\",\n  \"amount\": 2000.00,\n  \"fromAccountId\": \"{{bankAccountId}}\",\n  \"categoryId\": \"{{expenseCategoryId}}\",\n  \"description\": \"Groceries\",\n  \"transactionDate\": \"{{today}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "EXPENSE 1000 from cash (today)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"EXPENSE\",\n  \"amount\": 1000.00,\n  \"fromAccountId\": \"{{cashAccountId}}\",\n  \"categoryId\": \"{{expenseCategoryId}}\",\n  \"description\": \"Auto rickshaw\",\n  \"transactionDate\": \"{{today}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "EXPENSE 500 from bank LAST MONTH (window-exclusion test)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"EXPENSE\",\n  \"amount\": 500.00,\n  \"fromAccountId\": \"{{bankAccountId}}\",\n  \"categoryId\": \"{{expenseCategoryId}}\",\n  \"description\": \"Old bill\",\n  \"transactionDate\": \"{{lastMonth}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "TRANSFER 1000 bank → cash (invisible to income/expense)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"TRANSFER\",\n  \"amount\": 1000.00,\n  \"fromAccountId\": \"{{bankAccountId}}\",\n  \"toAccountId\": \"{{cashAccountId}}\",\n  \"description\": \"Cash withdrawal\",\n  \"transactionDate\": \"{{today}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "1 · Analytics endpoints",
      "item": [
        {
          "name": "income-expense MONTH → today's bucket 50000 / 3000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('series covers the month', () => pm.expect(body.series.length).to.be.at.least(28));",
                  "let income = 0, expense = 0;",
                  "body.series.forEach(p => { income += Number(p.income); expense += Number(p.expense); });",
                  "pm.test('income 50000, expense 3000 (500 excluded, transfer invisible)', () => {",
                  "  pm.expect(income).to.eql(50000);",
                  "  pm.expect(expense).to.eql(3000);",
                  "});",
                  "const todayBucket = body.series.find(p => p.bucket === pm.collectionVariables.get('today'));",
                  "pm.test('today bucket = 50000 / 3000', () => {",
                  "  pm.expect(Number(todayBucket.income)).to.eql(50000);",
                  "  pm.expect(Number(todayBucket.expense)).to.eql(3000);",
                  "});",
                  "console.log('period:', JSON.stringify(body.period));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/income-expense?periodType=MONTH",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "income-expense"],
              "query": [{ "key": "periodType", "value": "MONTH" }]
            }
          }
        },
        {
          "name": "spending-trend MONTH → Σ expense 3000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "let expense = 0;",
                  "body.series.forEach(p => expense += Number(p.expense));",
                  "pm.test('Σ expense = 3000', () => pm.expect(expense).to.eql(3000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/spending-trend?periodType=MONTH",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "spending-trend"],
              "query": [{ "key": "periodType", "value": "MONTH" }]
            }
          }
        },
        {
          "name": "spending-trend YEAR → 12 monthly buckets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('12 buckets', () => pm.expect(body.series.length).to.eql(12));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/spending-trend?periodType=YEAR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "spending-trend"],
              "query": [{ "key": "periodType", "value": "YEAR" }]
            }
          }
        },
        {
