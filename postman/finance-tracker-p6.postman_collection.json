                  "pm.test('one slice at 100%, sorted first', () => {",
                  "  pm.expect(body.categories.length).to.eql(1);",
                  "  pm.expect(Number(body.categories[0].amount)).to.eql(3000);",
                  "  pm.expect(body.categories[0].percentage).to.eql(100);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/expense-categories?periodType=MONTH",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "expense-categories"],
              "query": [{ "key": "periodType", "value": "MONTH" }]
            }
          }
        },
        {
          "name": "expense-categories YEAR → includes last month's 500",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('totalExpense at least 3000 (3500 when lastMonth is the same year)', () => {",
                  "  pm.expect(Number(body.totalExpense)).to.be.at.least(3000);",
                  "});",
                  "console.log('YEAR totalExpense:', body.totalExpense);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/expense-categories?periodType=YEAR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "expense-categories"],
              "query": [{ "key": "periodType", "value": "YEAR" }]
            }
          }
        },
        {
          "name": "savings-progress MONTH → starts at base 5000, ends 8000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('base from BEFORE the window = 5000', () => {",
                  "  pm.expect(Number(body.series[0].cumulative)).to.eql(5000);",
                  "});",
                  "pm.test('ends at 8000', () => {",
                  "  const last = body.series[body.series.length - 1];",
                  "  pm.expect(Number(last.cumulative)).to.eql(8000);",
                  "});",
                  "pm.test('goalId null when covering all goals', () => pm.expect(body.goalId).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/savings-progress?periodType=MONTH",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "savings-progress"],
              "query": [{ "key": "periodType", "value": "MONTH" }]
            }
          }
        },
        {
          "name": "savings-progress ?goalId= → same numbers, goal echoed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('goalId echoed', () => pm.expect(body.goalId).to.eql(pm.collectionVariables.get('goalId')));",
                  "const last = body.series[body.series.length - 1];",
                  "pm.test('ends at 8000', () => pm.expect(Number(last.cumulative)).to.eql(8000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/savings-progress?periodType=MONTH&goalId={{goalId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "savings-progress"],
              "query": [
                { "key": "periodType", "value": "MONTH" },
                { "key": "goalId", "value": "{{goalId}}" }
              ]
            }
          }
        },
        {
          "name": "savings-progress with unknown goalId → 404",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/savings-progress?goalId=00000000-0000-4000-8000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "savings-progress"],
              "query": [{ "key": "goalId", "value": "00000000-0000-4000-8000-000000000000" }]
            }
          }
        },
        {
          "name": "account-cashflow MONTH → bank in 50000 / out 3000, cash in 1000 / out 1000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const bank = body.accounts.find(a => a.name === 'HDFC Savings');",
                  "const cash = body.accounts.find(a => a.name === 'Cash Wallet');",
                  "pm.test('BANK in 50000 out 3000', () => {",
                  "  pm.expect(Number(bank.moneyIn)).to.eql(50000);",
                  "  pm.expect(Number(bank.moneyOut)).to.eql(3000);",
                  "});",
                  "pm.test('CASH in 1000 out 1000', () => {",
                  "  pm.expect(Number(cash.moneyIn)).to.eql(1000);",
                  "  pm.expect(Number(cash.moneyOut)).to.eql(1000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/account-cashflow?periodType=MONTH",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "account-cashflow"],
              "query": [{ "key": "periodType", "value": "MONTH" }]
            }
          }
