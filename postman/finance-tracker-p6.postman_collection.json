{
  "info": {
    "name": "Finance Tracker — P6 (Analytics)",
    "description": "IMPORTANT: use a FRESH Supabase test user — assertions check exact amounts.\n\nScenario built by the collection (today is 'T'):\n  BANK 20000, CASH 3000. One EXPENSE category reused. Goal 'Car' target 100000.\n  Contributions: 5000 dated last month (becomes the cumulative BASE) + 3000 today.\n  INCOME 50000 → bank (T) · EXPENSE 2000 (bank, T) · EXPENSE 1000 (cash, T)\n  EXPENSE 500 dated LAST MONTH (must be excluded from MONTH windows)\n  TRANSFER 1000 bank→cash (never enters income/expense)\n\nExpected MONTH window: income 50000, expense 3000, Food 100%,\ncashflow bank in 50000/out 3000, savings cumulative 5000 → 8000.",
    "_postman_id": "b1e2c3d4-0000-4000-8000-abcdef000006",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "supabaseUrl", "value": "https://ttqosjbjnpeioioiovsp.supabase.co" },
    { "key": "supabaseAnonKey", "value": "PASTE-YOUR-ANON-KEY" },
    { "key": "email", "value": "you@example.com" },
    { "key": "password", "value": "your-password" },
    { "key": "accessToken", "value": "" },
    { "key": "today", "value": "" },
    { "key": "lastMonth", "value": "" },
    { "key": "bankAccountId", "value": "" },
    { "key": "cashAccountId", "value": "" },
    { "key": "expenseCategoryId", "value": "" },
    { "key": "incomeCategoryId", "value": "" },
    { "key": "goalId", "value": "" }
  ],
  "item": [
    {
      "name": "0 · Login & setup",
      "item": [
        {
          "name": "Supabase login → {{accessToken}} + {{today}} + {{lastMonth}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('today', new Date().toISOString().slice(0, 10));",
                  "const d = new Date();",
                  "d.setMonth(d.getMonth() - 1);",
                  "pm.collectionVariables.set('lastMonth', d.toISOString().slice(0, 10));",
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set('accessToken', body.access_token);",
                  "  console.log('token saved, today =', pm.collectionVariables.get('today'), ', lastMonth =', pm.collectionVariables.get('lastMonth'));",
                  "} else {",
                  "  console.log('No access_token. Check email/password/anon key:', JSON.stringify(body));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabaseAnonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
              "host": ["{{supabaseUrl}}"],
              "path": ["auth", "v1", "token"],
              "query": [{ "key": "grant_type", "value": "password" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Sanity: GET /me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] }
          }
        },
        {
          "name": "Create BANK 20000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "if (body.id) pm.collectionVariables.set('bankAccountId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/accounts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HDFC Savings\",\n  \"accountType\": \"BANK\",\n  \"openingBalance\": 20000.00\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Create CASH 3000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "if (body.id) pm.collectionVariables.set('cashAccountId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/accounts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cash Wallet\",\n  \"accountType\": \"CASH\",\n  \"openingBalance\": 3000.00\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Grab first EXPENSE category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const first = body.find(c => c.categoryType === 'EXPENSE');",
                  "if (first) pm.collectionVariables.set('expenseCategoryId', first.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?type=EXPENSE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"],
              "query": [{ "key": "type", "value": "EXPENSE" }]
            }
          }
        },
        {
          "name": "Grab first INCOME category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
