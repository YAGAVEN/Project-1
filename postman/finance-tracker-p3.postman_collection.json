          }
        },
        {
          "name": "Create category Dining (EXPENSE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "if (body.id) pm.collectionVariables.set('diningCategoryId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/categories", "host": ["{{baseUrl}}"], "path": ["api", "v1", "categories"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dining\",\n  \"categoryType\": \"EXPENSE\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Grab first INCOME category id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const first = body.find(c => c.categoryType === 'INCOME');",
                  "if (first) pm.collectionVariables.set('incomeCategoryId', first.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?type=INCOME",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"],
              "query": [{ "key": "type", "value": "INCOME" }]
            }
          }
        }
      ]
    },
    {
      "name": "1 · Budget rules",
      "item": [
        {
          "name": "Create budget Dining/MONTHLY/10000 → 201, fresh usage OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('fresh usage: used 0, OK', () => {",
                  "  pm.expect(Number(body.used)).to.eql(0);",
                  "  pm.expect(body.status).to.eql('OK');",
                  "  pm.expect(Number(body.remaining)).to.eql(10000);",
                  "});",
                  "if (body.budgetId) pm.collectionVariables.set('budgetId', body.budgetId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/budgets", "host": ["{{baseUrl}}"], "path": ["api", "v1", "budgets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{diningCategoryId}}\",\n  \"amountLimit\": 10000.00,\n  \"periodType\": \"MONTHLY\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Duplicate Dining/MONTHLY → 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/budgets", "host": ["{{baseUrl}}"], "path": ["api", "v1", "budgets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{diningCategoryId}}\",\n  \"amountLimit\": 5000,\n  \"periodType\": \"MONTHLY\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Budget on INCOME category → 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/budgets", "host": ["{{baseUrl}}"], "path": ["api", "v1", "budgets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{incomeCategoryId}}\",\n  \"amountLimit\": 5000,\n  \"periodType\": \"MONTHLY\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Create WEEKLY budget for Dining → 201 (different period is allowed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "if (body.budgetId) pm.collectionVariables.set('weeklyBudgetId', body.budgetId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/budgets", "host": ["{{baseUrl}}"], "path": ["api", "v1", "budgets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{diningCategoryId}}\",\n  \"amountLimit\": 1500.00,\n  \"periodType\": \"WEEKLY\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "PUT weekly → MONTHLY → 409 (monthly already exists)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/budgets/{{weeklyBudgetId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "budgets", "{{weeklyBudgetId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"periodType\": \"MONTHLY\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "DELETE weekly budget → 204",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/v1/budgets/{{weeklyBudgetId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "budgets", "{{weeklyBudgetId}}"] }
          }
        }
      ]
    },
    {
      "name": "2 · Spend, then usage",
      "item": [
        {
          "name": "INCOME 50000 salary → bank",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"INCOME\",\n  \"amount\": 50000.00,\n  \"toAccountId\": \"{{bankAccountId}}\",\n  \"categoryId\": \"{{incomeCategoryId}}\",\n  \"description\": \"Monthly salary\",\n  \"transactionDate\": \"{{today}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "EXPENSE 4500 Dining from bank",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"EXPENSE\",\n  \"amount\": 4500.00,\n  \"fromAccountId\": \"{{bankAccountId}}\",\n  \"categoryId\": \"{{diningCategoryId}}\",\n  \"description\": \"Team dinner\",\n  \"transactionDate\": \"{{today}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "EXPENSE 3500 Dining from CARD (card spend counts toward budget)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"EXPENSE\",\n  \"amount\": 3500.00,\n  \"fromAccountId\": \"{{cardAccountId}}\",\n  \"categoryId\": \"{{diningCategoryId}}\",\n  \"description\": \"Anniversary dinner\",\n  \"transactionDate\": \"{{today}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "TRANSFER 2000 bank → cash (must NOT count anywhere)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"TRANSFER\",\n  \"amount\": 2000.00,\n  \"fromAccountId\": \"{{bankAccountId}}\",\n  \"toAccountId\": \"{{cashAccountId}}\",\n  \"description\": \"Cash withdrawal\",\n  \"transactionDate\": \"{{today}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "GET /budgets → spent 8000, exactly 80% = WARNING boundary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('totals', () => {",
                  "  pm.expect(Number(body.totals.totalBudget)).to.eql(10000);",
                  "  pm.expect(Number(body.totals.totalSpent)).to.eql(8000);",
                  "  pm.expect(Number(body.totals.totalRemaining)).to.eql(2000);",
                  "});",
                  "const dining = body.budgets.find(b => b.categoryName === 'Dining');",
                  "pm.test('Dining at exactly 80% → WARNING', () => {",
                  "  pm.expect(Number(dining.used)).to.eql(8000);",
                  "  pm.expect(dining.percentageUsed).to.eql(80);",
                  "  pm.expect(dining.status).to.eql('WARNING');",
                  "  pm.expect(Number(dining.remaining)).to.eql(2000);",
                  "});",
                  "console.log('window:', JSON.stringify(dining.window));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/budgets?date={{today}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "budgets"],
              "query": [{ "key": "date", "value": "{{today}}" }]
            }
          }
        },
        {
          "name": "Drill-down /budgets/{id}/transactions → 2 rows",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('2 contributing transactions', () => pm.expect(Number(body.totalElements)).to.eql(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/budgets/{{budgetId}}/transactions?date={{today}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "budgets", "{{budgetId}}", "transactions"],
              "query": [{ "key": "date", "value": "{{today}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "3 · History",
      "item": [
        {
          "name": "GET /budgets/{id}/history?periods=3 → 3 points, current = 8000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('3 points', () => pm.expect(body.points.length).to.eql(3));",
