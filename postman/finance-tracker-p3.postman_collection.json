                  "  pm.expect(current.status).to.eql('WARNING');",
                  "});",
                  "console.log('history:', JSON.stringify(body.points.map(p => [p.window.startDate, Number(p.used)])));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/budgets/{{budgetId}}/history?periods=3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "budgets", "{{budgetId}}", "history"],
              "query": [{ "key": "periods", "value": "3" }]
            }
          }
        }
      ]
    },
    {
      "name": "4 · Dashboard (one call)",
      "item": [
        {
          "name": "GET /dashboard?periodType=MONTH → all widgets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('totals: balance 70000, income 50000, expense 8000, net 42000', () => {",
                  "  pm.expect(Number(body.totals.totalBalance)).to.eql(70000);",
                  "  pm.expect(Number(body.totals.income)).to.eql(50000);",
                  "  pm.expect(Number(body.totals.expense)).to.eql(8000);",
                  "  pm.expect(Number(body.totals.netCashFlow)).to.eql(42000);",
                  "});",
                  "pm.test('expenseByCategory: Dining 8000 = 100%', () => {",
                  "  const dining = body.expenseByCategory.find(s => s.name === 'Dining');",
                  "  pm.expect(Number(dining.amount)).to.eql(8000);",
                  "  pm.expect(dining.percentage).to.eql(100);",
                  "});",
                  "pm.test('budget widget at 80% WARNING', () => {",
                  "  const dining = body.budgets.find(b => b.categoryName === 'Dining');",
                  "  pm.expect(Number(dining.used)).to.eql(8000);",
                  "  pm.expect(dining.status).to.eql('WARNING');",
                  "});",
                  "pm.test('3 account balances', () => pm.expect(body.accountBalances.length).to.eql(3));",
                  "pm.test('card widget: outstanding 3500, available 96500, monthSpend 3500', () => {",
                  "  const card = body.creditCards[0];",
                  "  pm.expect(Number(card.outstanding)).to.eql(3500);",
                  "  pm.expect(Number(card.availableCredit)).to.eql(96500);",
                  "  pm.expect(Number(card.monthSpend)).to.eql(3500);",
                  "});",
                  "pm.test('loans zeros until P4', () => {",
                  "  pm.expect(Number(body.loansSummary.totalReceivable)).to.eql(0);",
                  "  pm.expect(Number(body.loansSummary.totalPayable)).to.eql(0);",
                  "});",
                  "pm.test('recent ≤ 10', () => pm.expect(body.recentTransactions.length).to.be.at.most(10));",
                  "console.log('series points:', body.incomeExpenseSeries.length, '| period:', JSON.stringify(body.period));"
                ]
              }
            }
          ],
          "request": {
