{
  "info": {
    "name": "Finance Tracker — P2 (Transactions)",
    "description": "Setup (one time):\n1. Create a FRESH test user in Supabase (Authentication → Users → Add user) — clean state gives exact numbers.\n2. Fill collection variables: supabaseAnonKey, email, password (supabaseUrl is prefilled).\n3. Run 'Supabase login' first — it stores the JWT and today's date. Everything else auto-wires via variables.\n\nRe-running duplicates transactions, so re-run against a fresh user for exact-number checks.",
    "_postman_id": "b1e2c3d4-0000-4000-8000-abcdef000002",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "supabaseUrl", "value": "https://ttqosjbjnpeioioiovsp.supabase.co" },
    { "key": "supabaseAnonKey", "value": "PASTE-YOUR-ANON-KEY" },
    { "key": "email", "value": "you@example.com" },
    { "key": "password", "value": "your-password" },
    { "key": "accessToken", "value": "" },
    { "key": "today", "value": "" },
    { "key": "bankAccountId", "value": "" },
    { "key": "cashAccountId", "value": "" },
    { "key": "cardAccountId", "value": "" },
    { "key": "incomeCategoryId", "value": "" },
    { "key": "expenseCategoryId", "value": "" },
    { "key": "incomeTxnId", "value": "" },
    { "key": "expenseTxnId", "value": "" },
    { "key": "cardTxnId", "value": "" },
    { "key": "transferTxnId", "value": "" }
  ],
  "item": [
    {
      "name": "0 · Login & setup",
      "item": [
        {
          "name": "Supabase login → saves {{accessToken}} + {{today}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('today', new Date().toISOString().slice(0, 10));",
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set('accessToken', body.access_token);",
                  "  console.log('accessToken saved, today =', pm.collectionVariables.get('today'));",
                  "} else {",
                  "  console.log('No access_token. Check email/password/anon key:', JSON.stringify(body));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabaseAnonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
              "host": ["{{supabaseUrl}}"],
              "path": ["auth", "v1", "token"],
              "query": [{ "key": "grant_type", "value": "password" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Sanity: GET /me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "me"]
            }
          }
        },
        {
          "name": "Setup: create BANK (opening 25000)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "if (body.id) pm.collectionVariables.set('bankAccountId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/accounts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HDFC Savings\",\n  \"accountType\": \"BANK\",\n  \"openingBalance\": 25000.00\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Setup: create CASH (opening 3000)",
