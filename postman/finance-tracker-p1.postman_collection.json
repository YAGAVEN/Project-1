              "mode": "raw",
              "raw": "{\n  \"name\": \"Books & Courses\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete parent WITH active child → 204 but soft-deleted",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{parentCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{parentCategoryId}}"]
