        {
          "name": "INCOME under EXPENSE parent → 400 (type mismatch)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bonus\",\n  \"categoryType\": \"INCOME\",\n  \"parentCategoryId\": \"{{parentCategoryId}}\"\n}",
