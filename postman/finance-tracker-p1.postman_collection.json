          }
        },
        {
          "name": "Verify: parent gone from default list",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"]
            }
          }
        },
        {
          "name": "Verify: parent visible with includeInactive=true",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?includeInactive=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"],
              "query": [{ "key": "includeInactive", "value": "true" }]
            }
          }
        }
      ]
    }
  ]
}
